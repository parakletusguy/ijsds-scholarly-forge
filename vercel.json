{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed/latest-articles.xml",
      "destination": "https://ijsds-database-ftb5hpfrfecegtbz.switzerlandnorth-01.azurewebsites.net/feed/latest-articles.xml"
    },
    {
      "source": "/oai",
      "destination": "https://ijsds-database-ftb5hpfrfecegtbz.switzerlandnorth-01.azurewebsites.net/api/oai"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/article/:slug"
    },
    {
      "source": "/api/pdf/:id",
      "destination": "/api/pdf/:id"
    },
    {
      "source": "/papers",
      "destination": "https://ijsds-database-ftb5hpfrfecegtbz.switzerlandnorth-01.azurewebsites.net/papers"
    },
    {
      "source": "/papers/:id",
      "destination": "https://ijsds-database-ftb5hpfrfecegtbz.switzerlandnorth-01.azurewebsites.net/papers/:id"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
